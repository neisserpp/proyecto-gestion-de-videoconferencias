{
  "builds": [
    {
      "src": "reserva_vc/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9"
      }
    },
    {
      "src": "static/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "vite/dist/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "reserva_vc/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "reserva_vc.settings"
  }
}